POSTGRES_VERSION=18.3
SOLR_VERSION=9.7.0

CORE_VERSION=5.0.13
WEB_CLIENT_VERSION=2.4.14

WEB_CLIENT_DOMAIN=proarc.domain.cz

SOLR_JAVA_OPTS=-Xms4g -Xmx4g
